# 1. Lance `npx convex dev` une premiere fois : ca va ouvrir ton navigateur,
#    te demander de te connecter (GitHub ou email), creer le projet Convex,
#    puis remplir automatiquement ce fichier .env.local avec la bonne valeur.
NEXT_PUBLIC_CONVEX_URL=

# Stripe (mode test pour commencer — clés qui commencent par pk_test_ / sk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# La clé secrète ne va PAS ici : elle se configure uniquement côté Convex avec
# `npx convex env set STRIPE_SECRET_KEY sk_test_...` (voir README).
